FACTORY_DEF {*} TestFactory    FACTORY_NAME { Tester }    INPUT  FEATURE_TYPE GISP.HawkesBay_Catchments_LCDBv06_GEODATABASE_SDE_3    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Name_2023<closeparen>,Tester)" = Built-up<space>Area<space><openparen>settlement<closeparen> ENCODED } TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Name_2023<closeparen>,Tester)" = Urban<space>Parkland<solidus>Open<space>Space ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE Tester_PASSED         }
